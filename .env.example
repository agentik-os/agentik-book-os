# ── Agentik Book {OS} — configuration ────────────────────────────────────────
# Copy this file to `.env` and fill it in. `bun run bot.ts` loads it automatically.

# REQUIRED — your bot token from @BotFather (Telegram → /newbot)
TELEGRAM_BOT_TOKEN=

# REQUIRED — your numeric Telegram user id(s), comma-separated. Get yours from @userinfobot.
# The bot answers ONLY these ids. Everyone else is ignored. This is your security.
ALLOWED_USER_IDS=

# REQUIRED — your Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# OPTIONAL — the model. Any current Claude model id works; override if you like.
MODEL=claude-sonnet-4-5

# OPTIONAL — enables Whisper voice transcription as a FALLBACK when the local
# open-source transcriber (omega-transcribe / faster-whisper) is not installed.
OPENAI_API_KEY=

# OPTIONAL — where the ledger + preferences live (default ./data)
# DATA_DIR=./data
